{
  "name": "Stock Market ML (Python 3.11)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/Home.py"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": "python -m streamlit run src/Home.py --server.address 0.0.0.0",
  "portsAttributes": {
    "8501": {
      "label": "Stock Market ML",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
